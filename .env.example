NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Server-only key required for the authenticated account-deletion endpoint.
# Never prefix this key with NEXT_PUBLIC_ and never expose it in client code.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Vercel Cron sends this as a Bearer token to /api/cron/* routes.
CRON_SECRET=generate-a-long-random-string
FINNHUB_API_KEY=your-finnhub-api-key
NEXT_PUBLIC_REOWN_PROJECT_ID=your-reown-project-id
NEXT_PUBLIC_APP_URL=http://localhost:3021
ETHEREUM_BLOCKSCOUT_URL=https://eth.blockscout.com
BASE_BLOCKSCOUT_URL=https://base.blockscout.com
ARBITRUM_BLOCKSCOUT_URL=https://arbitrum.blockscout.com
OPTIMISM_BLOCKSCOUT_URL=https://explorer.optimism.io
POLYGON_BLOCKSCOUT_URL=https://polygon.blockscout.com
